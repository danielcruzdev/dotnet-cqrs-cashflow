<Project>

  <!--
    Configurações compartilhadas por todos os projetos das duas solutions.
    Centralizar aqui evita divergência entre os dez .csproj e garante que
    uma mudança de padrão (versão de linguagem, nível de warning) valha
    para o repositório inteiro de uma vez.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      InvariantGlobalization fica DESLIGADO de propósito.

      Ligá-lo reduz o tamanho da imagem e o tempo de inicialização, e foi a
      escolha inicial. Mas o domínio depende de TimeZoneInfo para resolver
      "hoje" no fuso America/Sao_Paulo (o dia contábil), e o mapeamento entre
      IDs IANA e Windows vem dos dados de ICU — que o modo invariante remove.
      Verificado por execução: com o modo ligado, IDs de fuso deixam de
      resolver de forma portátil entre Linux e Windows.

      Correção de dia no fluxo de caixa vale mais que alguns MB de imagem.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Warning vira erro. É deliberado: num projeto com prazo curto, warning
      acumulado é dívida que ninguém volta para pagar. O custo de disciplina
      é pago no momento em que o código é escrito, não depois.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      CA1031 (não capturar Exception genérica) não se aplica aqui: os laços de
      BackgroundService e o processamento de mensagem precisam sobreviver a
      qualquer falha, senão o serviço morre no primeiro erro transitório.
    -->
    <NoWarn>$(NoWarn);CA1031</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Determinismo de build, útil para CI e para diagnóstico de binário. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Daniel Cruz</Authors>
    <Product>Cashflow</Product>
  </PropertyGroup>

</Project>
